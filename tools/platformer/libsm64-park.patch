+#ifdef LIBSM64_PARK
+// Spatial grid over the static surfaces (the original game bins surfaces into cells; libsm64 scans every surface for
+// every query). A query (point or disc in x/z) selects the candidate static surfaces that the iterator below then
+// returns as group 0, so the collision loops in surface_collision.c are unchanged apart from one query call.
+#define GRID_CELL 256
+static int32_t s_grid_x0 = 0, s_grid_z0 = 0, s_grid_w = 0, s_grid_h = 0;
+static uint32_t *s_grid_start = NULL, *s_grid_items = NULL, *s_stamp = NULL, s_stamp_id = 0;
+static uint32_t *s_cand = NULL, s_cand_count = 0, s_cand_cap = 0;
+static int s_query_active = 0;
+
+static void grid_free( void )
+{
+    free( s_grid_start ); free( s_grid_items ); free( s_stamp );
+    s_grid_start = s_grid_items = s_stamp = NULL; s_grid_w = s_grid_h = 0;
+}
+
+static void grid_cell_range( const struct SM64SurfaceCollisionData *f, int32_t *i0, int32_t *i1, int32_t *j0, int32_t *j1 )
+{
+    int32_t xa = f->vertex1[0], xb = f->vertex1[0], za = f->vertex1[2], zb = f->vertex1[2];
+    if( f->vertex2[0] < xa ) xa = f->vertex2[0]; if( f->vertex2[0] > xb ) xb = f->vertex2[0];
+    if( f->vertex3[0] < xa ) xa = f->vertex3[0]; if( f->vertex3[0] > xb ) xb = f->vertex3[0];
+    if( f->vertex2[2] < za ) za = f->vertex2[2]; if( f->vertex2[2] > zb ) zb = f->vertex2[2];
+    if( f->vertex3[2] < za ) za = f->vertex3[2]; if( f->vertex3[2] > zb ) zb = f->vertex3[2];
+    *i0 = ( xa - s_grid_x0 ) / GRID_CELL; *i1 = ( xb - s_grid_x0 ) / GRID_CELL;
+    *j0 = ( za - s_grid_z0 ) / GRID_CELL; *j1 = ( zb - s_grid_z0 ) / GRID_CELL;
+}
+
+static void grid_build( void )
+{
+    grid_free();
+    int32_t valid = 0;
+    for( uint32_t k = 0; k < s_static_surface_count; ++k ) valid += s_static_surface_list[k].isValid ? 1 : 0;
+    if( valid == 0 ) return;
+    int32_t x0 = 0x7fffffff, x1 = -0x7fffffff, z0 = 0x7fffffff, z1 = -0x7fffffff;
+    for( uint32_t k = 0; k < s_static_surface_count; ++k )
+    {
+        const struct SM64SurfaceCollisionData *f = &s_static_surface_list[k];
+        if( !f->isValid ) continue;       // degenerate triangles are left half-initialised by engine_surface_from_lib_surface
+        const int32_t *v[3] = { f->vertex1, f->vertex2, f->vertex3 };
+        for( int q = 0; q < 3; ++q )
+        {
+            if( v[q][0] < x0 ) x0 = v[q][0]; if( v[q][0] > x1 ) x1 = v[q][0];
+            if( v[q][2] < z0 ) z0 = v[q][2]; if( v[q][2] > z1 ) z1 = v[q][2];
+        }
+    }
+    s_grid_x0 = x0 - GRID_CELL; s_grid_z0 = z0 - GRID_CELL;
+    s_grid_w = ( x1 - s_grid_x0 ) / GRID_CELL + 2; s_grid_h = ( z1 - s_grid_z0 ) / GRID_CELL + 2;
+    uint32_t cells = (uint32_t)( s_grid_w * s_grid_h );
+    s_grid_start = calloc( cells + 1, sizeof( uint32_t ));
+    for( uint32_t k = 0; k < s_static_surface_count; ++k )
+    {
+        if( !s_static_surface_list[k].isValid ) continue;
+        int32_t i0, i1, j0, j1; grid_cell_range( &s_static_surface_list[k], &i0, &i1, &j0, &j1 );
+        for( int32_t j = j0; j <= j1; ++j ) for( int32_t i = i0; i <= i1; ++i ) s_grid_start[ j * s_grid_w + i + 1 ]++;
+    }
+    for( uint32_t c = 0; c < cells; ++c ) s_grid_start[c + 1] += s_grid_start[c];
+    s_grid_items = malloc( sizeof( uint32_t ) * ( s_grid_start[cells] + 1 ));
+    uint32_t *fill = calloc( cells, sizeof( uint32_t ));
+    for( uint32_t k = 0; k < s_static_surface_count; ++k )
+    {
+        if( !s_static_surface_list[k].isValid ) continue;
+        int32_t i0, i1, j0, j1; grid_cell_range( &s_static_surface_list[k], &i0, &i1, &j0, &j1 );
+        for( int32_t j = j0; j <= j1; ++j ) for( int32_t i = i0; i <= i1; ++i )
+        {
+            uint32_t c = j * s_grid_w + i;
+            s_grid_items[ s_grid_start[c] + fill[c]++ ] = k;
+        }
+    }
+    free( fill );
+    s_stamp = calloc( s_static_surface_count, sizeof( uint32_t ));
+    s_stamp_id = 0;
+}
+
+// Select the static surfaces whose cells touch the disc (x, z, r); r = 0 for a point. Valid until the next query.
+void loaded_surface_iter_query( f32 x, f32 z, f32 r )
+{
+    s_query_active = 1;
+    s_cand_count = 0;
+    if( s_grid_start == NULL ) return;
+    int32_t i0 = (int32_t)floorf(( x - r - s_grid_x0 ) / GRID_CELL ), i1 = (int32_t)floorf(( x + r - s_grid_x0 ) / GRID_CELL );
+    int32_t j0 = (int32_t)floorf(( z - r - s_grid_z0 ) / GRID_CELL ), j1 = (int32_t)floorf(( z + r - s_grid_z0 ) / GRID_CELL );
+    if( i0 < 0 ) i0 = 0; if( j0 < 0 ) j0 = 0;
+    if( i1 >= s_grid_w ) i1 = s_grid_w - 1; if( j1 >= s_grid_h ) j1 = s_grid_h - 1;
+    int multi = ( i1 > i0 || j1 > j0 );
+    if( multi && ++s_stamp_id == 0 ) { memset( s_stamp, 0, sizeof( uint32_t ) * s_static_surface_count ); s_stamp_id = 1; }
+    for( int32_t j = j0; j <= j1; ++j ) for( int32_t i = i0; i <= i1; ++i )
+    {
+        uint32_t c = j * s_grid_w + i;
+        for( uint32_t q = s_grid_start[c]; q < s_grid_start[c + 1]; ++q )
+        {
+            uint32_t k = s_grid_items[q];
+            if( multi ) { if( s_stamp[k] == s_stamp_id ) continue; s_stamp[k] = s_stamp_id; }
+            if( s_cand_count == s_cand_cap )
+            {
+                s_cand_cap = s_cand_cap ? s_cand_cap * 2 : 1024;
+                s_cand = realloc( s_cand, sizeof( uint32_t ) * s_cand_cap );
+            }
+            s_cand[ s_cand_count++ ] = k;
+        }
+    }
+}
+#endif
